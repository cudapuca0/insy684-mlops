{
  "name": "INSY 684 MLOps",
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "forwardPorts": [5001, 8000, 5050, 4200, 3000, 9090],
  "portsAttributes": {
    "5001": { "label": "Frontend" },
    "8000": { "label": "Model API" },
    "5050": { "label": "MLflow" },
    "4200": { "label": "Prefect" },
    "3000": { "label": "Grafana" },
    "9090": { "label": "Prometheus" }
  },
  "postCreateCommand": "[ -f .env ] || cp .env.example .env"
}
